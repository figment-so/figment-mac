{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "so.figment/mac",
  "title": "Figment Mac hosting",
  "description": "Rent a Mac by the hour or day. An MCP server and a skill let AI agents order, use and stop it.",
  "version": "1.0.1",
  "websiteUrl": "https://figment.so/agents.md",
  "icons": [
    {
      "src": "https://figment.so/logo-256.png",
      "mimeType": "image/png",
      "sizes": [
        "256x256"
      ]
    },
    {
      "src": "https://figment.so/favicon.png",
      "mimeType": "image/png",
      "sizes": [
        "128x128"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/figment-so/figment-mac",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://figment.so/api/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Optional. \"Bearer <api_key>\" with the key from the figment_create_account tool. Without it, pass api_key to each tool.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
